    <p>Vibe Coding Framework v1.0 | Created by Rick Wells | <a href="https://urldefense.com/v3/__https://orchestrator-black.vercel.app/__;!!LgPfcEISpGU!5oFznLWbarGI6ojuILMLR2K9Mq-1xqBFuAYERyk9kqwWqrSm4zkv3SZLdnacAbMSe8UFd5vMt8GCHHVuDjLM$" target="_blank">Live Orchestrator →</a></p>
    <p style="margin-top: 0.5rem; font-size: 0.8rem;">The config file is the product. The UI is just the delivery mechanism.</p>
  </footer>

  <script>
    // Embedded JSON Configs
    const configs = {
      schema: {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "Orchestrator Config",
        "description": "Configuration file for a structured prompt generation pattern",
        "type": "object",
        "required": ["id", "name", "version", "layers", "phases"],
        "properties": {
          "id": { "type": "string", "description": "Unique identifier for this config" },
          "name": { "type": "string", "description": "Human-readable name" },
          "version": { "type": "string", "description": "Semantic version" },
          "description": { "type": "string" },
          "author": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "layers": {
            "type": "object",
            "description": "Which of the three core layers this config addresses",
            "properties": {
              "ux": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "weight": { "type": "string", "enum": ["primary", "secondary", "minimal"] } } },
              "api": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "weight": { "type": "string", "enum": ["primary", "secondary", "minimal"] } } },
              "schema": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "weight": { "type": "string", "enum": ["primary", "secondary", "minimal"] } } }
            }
          },
          "phases": {
            "type": "array",
            "description": "Ordered list of phases",
            "items": {
              "type": "object",
              "required": ["id", "name", "prompts"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "emoji": { "type": "string" },
                "color": { "type": "string" },
                "description": { "type": "string" },
                "skippable": { "type": "boolean", "default": false },
                "prompts": { "type": "array", "description": "Questions/inputs for this phase" },
                "gates": { "type": "array", "description": "Quality gates that must pass" }
              }
            }
          },
          "output": { "type": "object", "description": "How to format the final structured prompt" },
          "compliance": { "type": "object", "description": "Optional compliance requirements" }
        }
      },
      crud: {
        "id": "crud-form-v1",
        "name": "CRUD Form Builder",
        "version": "1.0.0",
        "description": "For data entry forms with create, read, update, delete operations",
        "author": "Rick Wells",
        "tags": ["form", "crud", "data-entry", "healthcare"],
        "layers": {
          "ux": { "enabled": true, "weight": "primary" },
          "api": { "enabled": true, "weight": "secondary" },
          "schema": { "enabled": true, "weight": "secondary" }
        },
        "phases": [
          { "id": "context", "name": "Context", "emoji": "🔵", "prompts": ["form_purpose", "screenshot", "tech_stack"], "gates": ["purpose_clear", "stack_confirmed"] },
          { "id": "fields", "name": "Form Fields", "emoji": "🟣", "prompts": ["field_list", "required_fields", "validation_rules"], "gates": ["fields_defined", "validation_defined"] },
          { "id": "workflow", "name": "Workflow", "emoji": "🟡", "prompts": ["submit_action", "approval_workflow", "notifications"], "gates": ["workflow_defined"] },
          { "id": "data", "name": "Data Model", "emoji": "🟢", "prompts": ["related_data", "dropdown_sources"], "gates": ["data_relationships_clear"] },
          { "id": "hardening", "name": "Quality & Testing", "emoji": "🔴", "prompts": ["test_scenarios", "error_handling", "accessibility"], "gates": ["test_coverage", "a11y_confirmed"] }
        ],
        "output": { "formats": ["markdown", "pdf", "clipboard"] },
        "compliance": { "frameworks": ["HCA-Security"], "requiredGates": ["purpose_clear", "validation_defined", "test_coverage"] }
      },
      dashboard: {
        "id": "dashboard-v1",
        "name": "Analytics Dashboard",
        "version": "1.0.0",
        "description": "For metrics dashboards with charts, filters, and drill-downs",
        "author": "Rick Wells",
        "tags": ["dashboard", "analytics", "charts", "reporting"],
        "layers": {
          "ux": { "enabled": true, "weight": "primary" },
          "api": { "enabled": true, "weight": "primary" },
          "schema": { "enabled": true, "weight": "secondary" }
        },
        "phases": [
          { "id": "context", "name": "Context", "emoji": "🔵", "prompts": ["dashboard_purpose", "primary_audience", "screenshot"], "gates": ["purpose_clear", "audience_identified"] },
          { "id": "metrics", "name": "Metrics", "emoji": "🟣", "prompts": ["kpis", "metric_calculations", "refresh_frequency"], "gates": ["kpis_defined", "calculations_clear"] },
          { "id": "visualizations", "name": "Visualizations", "emoji": "🟡", "prompts": ["chart_types", "layout", "interactions"], "gates": ["viz_defined"] },
          { "id": "filters", "name": "Filters & Drill-downs", "emoji": "🟢", "prompts": ["filter_list", "default_view", "drilldown_paths"], "gates": ["filters_defined"] },
          { "id": "data_sources", "name": "Data Sources", "emoji": "🔴", "prompts": ["sources", "data_volume", "access_control"], "gates": ["sources_identified", "access_defined"] }
        ],
        "output": { "formats": ["markdown", "pdf", "clipboard"] },
        "compliance": { "frameworks": ["HCA-Security"], "requiredGates": ["purpose_clear", "access_defined"] }
      },
      api: {
        "id": "api-integration-v1",
        "name": "API Integration",
        "version": "1.0.0",
        "description": "For connecting to external or internal APIs with proper error handling",
        "author": "Rick Wells",
        "tags": ["api", "integration", "backend", "services"],
        "layers": {
          "ux": { "enabled": true, "weight": "minimal" },
          "api": { "enabled": true, "weight": "primary" },
          "schema": { "enabled": true, "weight": "primary" }
        },
        "phases": [
          { "id": "context", "name": "Context", "emoji": "🔵", "prompts": ["integration_purpose", "direction", "trigger"], "gates": ["purpose_clear"] },
          { "id": "endpoints", "name": "Endpoints", "emoji": "🟣", "prompts": ["external_endpoints", "internal_endpoints", "api_docs"], "gates": ["endpoints_defined"] },
          { "id": "authentication", "name": "Authentication", "emoji": "🟡", "prompts": ["auth_method", "credential_storage", "token_refresh"], "gates": ["auth_defined", "secrets_secure"] },
          { "id": "data_mapping", "name": "Data Mapping", "emoji": "🟢", "prompts": ["field_mapping", "transformations", "validation"], "gates": ["mapping_complete"] },
          { "id": "error_handling", "name": "Error Handling", "emoji": "🔴", "prompts": ["retry_strategy", "timeout", "failure_notification", "circuit_breaker"], "gates": ["error_handling_defined", "monitoring_defined"] }
        ],
        "output": { "formats": ["markdown", "pdf", "clipboard"] },
        "compliance": { "frameworks": ["HCA-Security", "SOC2"], "requiredGates": ["auth_defined", "secrets_secure", "error_handling_defined"] }
      }
    };

    // Populate JSON viewers
    document.getElementById('schema-json').textContent = JSON.stringify(configs.schema, null, 2);
    document.getElementById('crud-json').textContent = JSON.stringify(configs.crud, null, 2);
    document.getElementById('dashboard-json').textContent = JSON.stringify(configs.dashboard, null, 2);
    document.getElementById('api-json').textContent = JSON.stringify(configs.api, null, 2);

    // Navigation
    document.querySelectorAll('.nav-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        
        document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
        document.getElementById(btn.dataset.section).classList.add('active');
        
        // Reset config view when switching sections
        if (btn.dataset.section === 'configs') {
          showConfigList();
        }
      });
    });

    // Config card clicks
    document.querySelectorAll('.config-card').forEach(card => {
      card.addEventListener('click', () => {
        const configId = card.dataset.config;
        showConfigDetail(configId);
        
        // Also switch to configs section if on overview
        document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
        document.querySelector('[data-section="configs"]').classList.add('active');
        document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
        document.getElementById('configs').classList.add('active');
      });
    });

    function showConfigList() {
      document.getElementById('config-list').style.display = 'block';
      document.querySelectorAll('.config-detail').forEach(d => d.classList.remove('active'));
    }

    function showConfigDetail(configId) {
      document.getElementById('config-list').style.display = 'none';
      document.querySelectorAll('.config-detail').forEach(d => d.classList.remove('active'));
      document.getElementById('config-' + configId).classList.add('active');
    }

    // Phase toggle
    function togglePhase(header) {
      const item = header.parentElement;
      item.classList.toggle('expanded');
    }

    // JSON viewer toggle
    function toggleJsonViewer() {
      document.getElementById('json-viewer').classList.toggle('active');
    }

    // JSON tabs
    document.querySelectorAll('.json-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.json-tab').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        
        document.querySelectorAll('.json-content').forEach(c => c.classList.remove('active'));
        document.getElementById('json-' + tab.dataset.json).classList.add('active');
      });
    });
  </script>

</body>
</html>
